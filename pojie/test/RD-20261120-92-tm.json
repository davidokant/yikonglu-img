{"dur": 32.799, "lines": [{"role": "ask", "card": 1, "text": "大学英语改选修了？校方补了一句：没过免修线，照样得上课。", "t0": 0.1, "t1": 5.174, "ch": [["大", 0.255, 0.435], ["学", 0.435, 0.585], ["英", 0.585, 0.665], ["语", 0.665, 0.885], ["改", 0.885, 1.005], ["选", 1.005, 1.165], ["修", 1.165, 1.345], ["了", 1.345, 1.505], ["校", 2.02, 2.095], ["方", 2.095, 2.225], ["补", 2.225, 2.385], ["了", 2.385, 2.475], ["一", 2.475, 2.565], ["句", 2.645, 2.675], ["没", 3.095, 3.285], ["过", 3.285, 3.405], ["免", 3.405, 3.535], ["修", 3.535, 3.685], ["线", 3.685, 4.055], ["照", 4.105, 4.385], ["样", 4.385, 4.495], ["得", 4.495, 4.575], ["上", 4.575, 4.725], ["课", 4.725, 4.965]]}, {"role": "hook", "card": 1, "text": "孔子十二个字，问你为谁学：", "t0": 5.254, "t1": 7.879, "ch": [["孔", 5.419, 5.669], ["子", 5.669, 5.799], ["十", 5.799, 5.969], ["二", 5.969, 6.069], ["个", 6.069, 6.179], ["字", 6.179, 6.489], ["问", 6.749, 6.869], ["你", 6.869, 7.029], ["为", 7.029, 7.159], ["谁", 7.159, 7.359], ["学", 7.359, 7.389]]}, {"role": "quote", "card": 2, "text": "古之学者为己，今之学者为人。", "t0": 10.429, "t1": 13.64, "ch": [["古", 10.624, 10.804], ["之", 10.804, 10.904], ["学", 10.904, 11.124], ["者", 11.124, 11.294], ["为", 11.294, 11.474], ["己", 11.474, 11.854], ["今", 12.104, 12.334], ["之", 12.334, 12.454], ["学", 12.454, 12.714], ["者", 12.714, 12.884], ["为", 12.884, 13.064], ["人", 13.064, 13.494]]}, {"role": "gloss", "card": 3, "text": "古人学习为自己长本事，今人学习做给别人看。", "t0": 14.67, "t1": 18.963, "ch": [["古", 14.855, 15.025], ["人", 15.025, 15.125], ["学", 15.125, 15.275], ["习", 15.275, 15.585], ["为", 15.735, 15.855], ["自", 15.855, 15.975], ["己", 15.975, 16.065], ["长", 16.065, 16.225], ["本", 16.225, 16.375], ["事", 16.375, 16.725], ["今", 17.015, 17.175], ["人", 17.175, 17.335], ["学", 17.335, 17.475], ["习", 17.475, 17.745], ["做", 17.965, 18.185], ["给", 18.185, 18.295], ["别", 18.295, 18.465], ["人", 18.465, 18.575], ["看", 18.575, 18.705]]}, {"role": "twist", "card": 4, "text": "为己为人，差在哪？程子说：古之学者为己，其终至于成物。先成就自己，再成就别人。", "t0": 19.203, "t1": 27.07, "ch": [["为", 19.358, 19.578], ["己", 19.578,